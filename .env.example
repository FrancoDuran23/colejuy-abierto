# Address of the deployed site, without a trailing slash. Used in the bot's messages.
NEXT_PUBLIC_SITE_URL=

# Santa Ana's fleet needs a signed-in user since 8 Oct 2026. This is the session secret of one account
# on their Appwrite (the value of the a_session_<project> cookie after signing in). It lasts a year.
# Without it the site shows routes and stops but no live positions.
SANTA_ANA_SESSION=
# Seconds the CDN keeps each fleet reading. Raise it if Santa Ana limits how often we may ask.
FLEET_CACHE_SECONDS=

# Google Analytics measurement ID, the one that starts with "G-". Without it no visits are sent to Google.
# Events carry a line id and, when relevant, a stop id: not the visitor's location, a typed address, or a Telegram chat.
# The site still asks for no account.
NEXT_PUBLIC_GA_ID=

# Telegram bot. Create it with @BotFather: it gives the token and the username (without the @).
# Without NEXT_PUBLIC_TELEGRAM_BOT the "Avisarme por Telegram" button is not shown.
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT=
# Any long random string. Telegram repeats it on every call to the webhook.
TELEGRAM_WEBHOOK_SECRET=

# Any long random string. Whoever calls /api/telegram/tick?key=... every minute needs it.
TICK_SECRET=

# Feedback: destino de la cajita de comentarios. Preferentemente el chat privado del administrador.
# El bot debe haber recibido al menos un mensaje de ese chat para poder escribirle.
FEEDBACK_CHAT_ID=
# Alternativa opcional: webhook de Slack, Discord, Make, n8n, etc. Se usa si no hay Telegram configurado.
FEEDBACK_WEBHOOK_URL=

# Cloudflare Turnstile (CAPTCHA gratuito). Activarlo en producción agregando ambas claves.
# La site key es pública y se usa en el navegador; el secret solo vive en el servidor.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis, where pending alerts are kept. Vercel's Upstash integration fills these in.
KV_REST_API_URL=
KV_REST_API_TOKEN=
